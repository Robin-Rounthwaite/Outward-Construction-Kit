<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />
  <Target Name="CheckKitPaths" BeforeTargets="ResolveAssemblyReferences" Condition="'$(OutwardManaged)' == '' Or '$(ProfileDir)' == ''">
    <Error Text="Building the kit needs to know where the game is. Copy Directory.Build.user.props.example to Directory.Build.user.props and fill it in." />
  </Target>
</Project>
